      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿El Grand Hotel Central tiene piscina en la azotea?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, una piscina infinita en la octava planta, junto a La Terraza del Central."
          }
        },
        {
          "@type": "Question",
          "name": "¿A qué distancia está el aeropuerto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El aeropuerto de Barcelona-El Prat está a unos 15 km del hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué historia tiene el edificio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es un edificio de los años veinte del arquitecto Adolf Florensa, antigua residencia de Francesc Cambó, y funciona como hotel desde 2005."
