    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Se puede ir a Necker Island sin alquilar toda la isla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En fechas concretas se reservan habitaciones individuales; el resto del año la isla se alquila completa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necker Island es todo incluido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: comidas, bebidas con alcohol, la mayoría de las actividades y el traslado en barco. El spa y algunas actividades se pagan aparte."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se llega a Necker Island?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En avión a Beef Island (EIS) o Virgin Gorda (VIJ) y, desde allí, en lancha incluida en la tarifa; desde Beef Island son unos 30 minutos."
          }
        }
      ]
