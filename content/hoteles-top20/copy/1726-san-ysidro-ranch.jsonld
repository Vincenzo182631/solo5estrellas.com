      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿San Ysidro Ranch admite mascotas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, en todos los cottages, con un cargo por estancia; no en el restaurante, el spa ni la piscina."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué tamaño tienen los cottages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De unos 72 m² (Daisy) a 557 m² (Warner, con piscina privada)."
          }
        },
        {
          "@type": "Question",
          "name": "¿A qué distancia está el aeropuerto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El aeropuerto de Santa Bárbara (SBA) está a menos de 24 km, unos 20 a 25 minutos en coche."
          }
        }
      ]
