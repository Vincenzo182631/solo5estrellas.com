      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿A qué distancia está el aeropuerto de Austin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A unos 95 km, alrededor de una hora en coche."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos campos de golf tiene?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tres abiertos a huéspedes, de Robert Trent Jones Sr.: Slick Rock, Apple Rock y Ram Rock. Un cuarto, Summit Rock, de Jack Nicklaus, es solo para socios."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede nadar en el lago?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No desde el resort. Hay tres piscinas, entre ellas una piscina flotante en el lago."
          }
        }
