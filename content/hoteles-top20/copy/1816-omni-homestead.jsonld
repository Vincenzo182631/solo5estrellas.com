      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿El Omni Homestead tiene piscinas termales?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: Serenity Garden, de agua de manantial y solo para adultos; el parque acuático Allegheny Springs, y las históricas Warm Springs Pools, a unos 8 km."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos campos de golf tiene?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dos: el Old Course, de 1892, y el Cascades Course, de William Flynn."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es el aeropuerto más cercano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roanoke (ROA), a unos 100 km y alrededor de una hora y media en coche."
          }
