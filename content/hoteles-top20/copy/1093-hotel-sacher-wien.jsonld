    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿A qué distancia está el Hotel Sacher Wien del aeropuerto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A unos 30 minutos en coche del aeropuerto de Viena. El hotel puede organizar el traslado con cargo; también hay tren (CAT o S-Bahn) y taxi."
          }
        },
        {
          "@type": "Question",
          "name": "¿Está incluido el desayuno?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la tarifa del hotel, normalmente no. Al reservar con Solo5Estrellas, el desayuno diario para dos forma parte de las ventajas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay código de vestimenta en los restaurantes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No hay un código formal. El hotel recomienda ropa elegante o smart casual en la Rote Bar y la Grüne Bar."
          }
        },
        {
          "@type": "Question",
          "name": "¿A qué hora son la entrada y la salida?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La entrada es a partir de las 15:00 y la salida, hasta las 12:00."
          }
        }
      ]
    }
