        {
          "@type": "Question",
          "name": "¿En qué barrio está el Altstadt Vienna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el Spittelberg, en el distrito 7 (Neubau), a pocos minutos a pie del MuseumsQuartier."
