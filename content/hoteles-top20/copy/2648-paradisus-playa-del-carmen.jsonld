        {
          "@type": "Question",
          "name": "¿Sigue existiendo Paradisus La Esmeralda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No con ese nombre: desde 2020 se llama Paradisus Playa del Carmen, para familias. La zona solo para adultos es Paradisus La Perla."
