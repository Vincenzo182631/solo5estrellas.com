        },
        {
          "@type": "Question",
          "name": "¿A qué distancia está el aeropuerto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El aeropuerto Harry Reid (LAS) está a unos 5 km, entre 10 y 15 minutos en coche."
          }
        },
