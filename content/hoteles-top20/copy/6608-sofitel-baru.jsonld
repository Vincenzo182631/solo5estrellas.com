      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿El Sofitel Barú es todo incluido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El hotel no tiene plan todo incluido; ofrece desayuno y restaurantes a la carta. Al reservar con Solo5Estrellas, el desayuno para dos está incluido."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se llega desde el aeropuerto de Cartagena?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En unos 65 a 80 minutos: 20 minutos en coche y de 45 a 60 en catamarán, o por carretera."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tiene club infantil?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, Kids Villa, para niños de 3 a 12 años."
