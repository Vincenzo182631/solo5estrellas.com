    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Conrad directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Conrad con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de hasta 100 USD, mejora de habitación, entrada anticipada y salida tardía según disponibilidad, un detalle de bienvenida y reconocimiento VIP. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Hilton Honors al reservar Conrad con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página del hotel, sí: se añade su número de Hilton Honors a la reserva y los puntos se suman en esa estancia. Confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Conrad se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "44 hoteles en 23 países y territorios. Los países con más hoteles son China, Estados Unidos, India."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Conrad hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Conrad Punta de Mita. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Conrad hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "7 hoteles, entre ellos Conrad Los Angeles, Conrad Washington DC, Conrad Fort Lauderdale Beach, Conrad Orlando, Conrad Indianapolis, Conrad New York Downtown y 1 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Hilton for Luxury?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Hilton para asesores de viajes de lujo, por invitación (antes se llamaba Impresario), y abarca Waldorf Astoria, Conrad y LXR. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Conrad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
