    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Oberoi directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Oberoi con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, entrada anticipada y salida tardía según disponibilidad, reconocimiento VIP y Wi-Fi de cortesía. Las condiciones se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Oberoi One al reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se confirma al hacer la reserva, así que facilite su número de socio. Pregunte antes de reservar si esta tarifa suma puntos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Oberoi se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4 hoteles en 2 países y territorios. Los países con más hoteles son India, Marruecos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Oberoi hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Oberoi hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en Estados Unidos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el programa de socio preferente de Oberoi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oberoi trabaja con un número reducido de agencias de viaje socias preferentes, y Solo5Estrellas es una de ellas. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Oberoi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
