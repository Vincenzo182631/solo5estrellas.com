    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Raffles directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Raffles con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, entrada anticipada y salida tardía según disponibilidad, detalle de bienvenida y Wi-Fi de cortesía. El desayuno, el crédito, el detalle y el Wi-Fi se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Accor ALL al reservar Raffles con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de cada hotel, sí: se añade su número de Accor ALL a la reserva y los puntos y noches de nivel se suman en esa estancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Raffles se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "21 hoteles en 16 países. Singapur, Camboya, China, Indonesia y los Emiratos Árabes Unidos tienen dos cada uno; los demás países, uno."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Raffles hay en Europa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le Royal Monceau - Raffles Paris, Raffles London at The OWO, Raffles Europejski Warsaw y Raffles Istanbul."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es el hotel Raffles más antiguo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Raffles Hotel Singapore. La marca toma su nombre de este hotel, que abrió en 1887."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Raffles hay en Singapur?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Raffles Hotel Singapore y Raffles Sentosa Singapore, en la isla de Sentosa. Los dos se pueden reservar con las ventajas de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Raffles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay Raffles en América?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uno en esta página: Raffles Boston Back Bay Hotel, en Boston."
          }
        }
      ]
