    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo ver la Gran Migración en el Masái Mara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Normalmente entre julio y octubre, cuando las manadas llegan desde el Serengeti. Las fechas varían cada año según las lluvias."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se llega al Masái Mara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En avioneta desde el aeropuerto Wilson de Nairobi, unos 45 a 60 minutos, o por carretera, entre 5 y 6 horas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es una reserva privada (conservancy)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un área protegida junto a la reserva nacional, en tierras masái arrendadas a los campamentos. Suelen limitar el número de camas y cobran sus propias tasas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se necesita visado para Kenia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se necesita una Autorización Electrónica de Viaje (eTA), que se solicita antes del viaje en etakenya.go.ke."
          }
        },
        {
          "@type": "Question",
          "name": "¿Están incluidos los safaris?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En The Ritz-Carlton y en Mahali Mzuri, sí, junto con las comidas. En Fairmont Mara Safari Club, confírmelo con su asesor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Pueden ir niños?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Mahali Mzuri admite niños desde 2 años y The Ritz-Carlton, desde 6."
          }
        }
      ]
    }
  ]
