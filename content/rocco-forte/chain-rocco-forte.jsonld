    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Rocco Forte directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Rocco Forte con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, mejora de habitación prioritaria, entrada anticipada y salida tardía según disponibilidad, un detalle de bienvenida y Wi-Fi de cortesía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Rocco Forte Friends al reservar Rocco Forte con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de cada hotel, sí: se añade su número de Rocco Forte Friends a la reserva y los puntos se suman en esa estancia. Confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Rocco Forte se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "14 hoteles en 4 países y territorios. Los países con más hoteles son Italia, Alemania, Reino Unido."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Rocco Forte hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México ni en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Rocco Forte hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en Estados Unidos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Rocco Forte Knights?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Rocco Forte Hotels para asesores de viaje, al que se accede por invitación y solo a través de un asesor participante. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas varían según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Rocco Forte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
