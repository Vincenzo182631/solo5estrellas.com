    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Waldorf Astoria directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Waldorf Astoria con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD por estancia, entrada anticipada y salida tardía según disponibilidad, un detalle de bienvenida y estatus VIP. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Hilton Honors al reservar Waldorf Astoria con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página del hotel, sí: se añade su número de Hilton Honors a la reserva y los puntos se suman en esa estancia. Confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Waldorf Astoria se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "39 hoteles en 20 países y territorios. Los países con más hoteles son Estados Unidos, China, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Waldorf Astoria hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Waldorf Astoria Cancun, Waldorf Astoria Los Cabos Pedregal, Waldorf Astoria Riviera Maya. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Waldorf Astoria hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "13 hoteles, entre ellos Arizona Biltmore Resort and Spa, Waldorf Astoria Beverly Hills, Waldorf Astoria Monarch Beach, Waldorf Astoria Washington D.C., Waldorf Astoria Orlando, Waldorf Astoria Atlanta Buckhead y 7 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Hilton for Luxury?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Hilton para asesores de viajes de lujo, por invitación (antes se llamaba Impresario), y abarca Waldorf Astoria, Conrad y LXR. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Waldorf Astoria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
