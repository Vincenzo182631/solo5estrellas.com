    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar 1 Hotels directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar 1 Hotels con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito de hotel (100 USD por estancia), mejora de habitación, entrada anticipada y salida tardía y detalle de bienvenida. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sumo puntos de fidelización al reservar 1 Hotels con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No está confirmado de forma pública que las reservas de asesor sumen puntos. Pregúntelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles 1 Hotels se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "10 hoteles en 4 países y territorios. Los países con más hoteles son Estados Unidos, Canadá, Dinamarca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles 1 Hotels hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México ni en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles 1 Hotels hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "7 hoteles, entre ellos 1 Hotel San Francisco, 1 Hotel West Hollywood, 1 Hotel South Beach, 1 Hotel Hanalei Bay, 1 Hotel Brooklyn Bridge, 1 Hotel Central Park y 1 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Programa de socios preferentes de 1 Hotels (nombre por confirmar)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1 Hotels trabaja con un número reducido de agencias de viajes socias preferentes. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de 1 Hotels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
