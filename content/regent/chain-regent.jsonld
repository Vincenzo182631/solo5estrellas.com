    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Regent directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Regent con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito de hotel (100 USD por estancia), mejora de habitación y entrada anticipada y salida tardía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de IHG One Rewards al reservar Regent con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según fuentes públicas, las reservas de IHG Destined siguen sumando puntos y noches de nivel de IHG One Rewards. Añada su número de socio a la reserva y confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Regent se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "10 hoteles en 7 países y territorios. Los países con más hoteles son China, Estados Unidos, Francia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Regent hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México ni en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Regent hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1 hoteles: Regent Santa Monica Beach."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es IHG Destined?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de IHG para asesores de viaje de lujo; cubre hoteles seleccionados de InterContinental, Kimpton, Six Senses, Regent, Vignette Collection y Hotel Indigo. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Regent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
  ]
