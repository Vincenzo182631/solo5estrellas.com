    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo es mejor viajar a Seychelles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hace calor todo el año. Abril, mayo, octubre y noviembre son los meses de transición entre los vientos alisios, con mar más tranquilo; de diciembre a febrero llueve más."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se va de Mahé a Praslin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En avión con Air Seychelles, en unos 15 minutos, o en el ferri Cat Cocos desde Victoria, en alrededor de una hora."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué isla elegir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahé, por comodidad, porque tiene el aeropuerto internacional; Praslin, por sus playas y el Vallée de Mai; una isla privada, como Desroches, Platte o North Island, para máxima privacidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se necesita visado para Seychelles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, pero hay que tramitar antes del viaje la Travel Authorisation en seychelles.govtas.com. Al llegar se pide pasaporte válido, billete de vuelta y alojamiento confirmado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay hoteles con club infantil en Seychelles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: los dos Four Seasons, Raffles Seychelles, Waldorf Astoria Platte Island y Mango House."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué moneda se usa en Seychelles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La rupia de Seychelles (SCR)."
          }
        }
      ]
    }
  ]
