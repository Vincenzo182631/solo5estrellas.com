    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Aman directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa flexible publicada que Aman, y las ventajas se añaden a esa tarifa. La tarifa publicada no incluye desayuno diario para dos ni crédito para gastos en el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Aman tiene programa de puntos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Aman no tiene un programa de fidelización por puntos. Aman Club es una membresía privada aparte, con invitaciones y prioridad de reserva para sus socios, no un programa de puntos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Aman con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito para gastos en el hotel (normalmente 100 USD, según el hotel), mejora de categoría sujeta a disponibilidad, entrada anticipada y salida tardía según disponibilidad, y reconocimiento VIP. Las condiciones se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Aman se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "20 hoteles en 14 países: tres en Estados Unidos, tres en Indonesia, tres en Japón y uno en cada uno de los demás. Aman tiene más hoteles y proyectos; esta página reúne los que se reservan con estas ventajas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Aman hay en Japón?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aman Tokyo, en la capital; Aman Kyoto, en Kioto, y Amanemu, en Shima. Los tres se pueden reservar con las ventajas de Aman Preferred Partner."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Aman hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aman New York, en Nueva York; Amangiri, en Utah, y Amangani, en Wyoming, en la zona de Jackson Hole."
          }
        },
        {
          "@type": "Question",
          "name": "¿La mejora de categoría de Aman está garantizada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Es una categoría superior si hay disponibilidad al hacer el check-in y no se confirma por adelantado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Aman?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál fue el primer hotel Aman?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amanpuri, en Phuket (Tailandia), que abrió en 1988. Se puede reservar con las ventajas de esta página."
          }
        }
      ]
    }
