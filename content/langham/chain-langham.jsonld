    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Langham directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Langham con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD por estancia, mejora de habitación, entrada anticipada y salida tardía según disponibilidad y un detalle de bienvenida. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sumo puntos de fidelización al reservar Langham con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No está confirmado de forma pública que las reservas de asesor sumen puntos. Pregúntelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Langham se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12 hoteles en 7 países y territorios. Los países con más hoteles son Estados Unidos, Australia, China."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Langham hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México ni en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Langham hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4 hoteles: The Langham Huntington, Pasadena, Los Angeles, The Langham, Chicago, The Langham Boston, The Langham, New York, Fifth Avenue."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es COUTURE by Langham?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Langham Hospitality Group para asesores de viajes, por invitación, y abarca Langham y otros hoteles del grupo. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Langham?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
