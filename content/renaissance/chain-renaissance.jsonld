    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Renaissance directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Renaissance con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, entrada anticipada y salida tardía según disponibilidad, detalle de bienvenida y Wi-Fi. El desayuno, el crédito, el detalle y el Wi-Fi se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Marriott Bonvoy al reservar Renaissance con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de cada hotel, sí: se añade su número de Marriott Bonvoy a la reserva. Confirme al reservar que esa tarifa suma puntos y noches de nivel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Renaissance se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "29 hoteles en 16 países y territorios. Los países con más hoteles son Estados Unidos, Francia, Aruba."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Renaissance hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México. En España: Renaissance Barcelona Hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Renaissance hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "11 hoteles, entre ellos Renaissance Esmeralda Resort & Spa at Indian Wells, Renaissance Orlando at SeaWorld, Renaissance Chicago Downtown Hotel, Hotel de la Poste – French Quarter, A Renaissance Hotel, Renaissance Boston Seaport District, Renaissance Reno Downtown Hotel & Spa y 5 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Marriott Luminous?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Marriott International para asesores de viaje de las marcas premium, como Renaissance, Westin, Sheraton, JW Marriott, W Hotels, Le Méridien y Autograph Collection. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos; solo participan hoteles seleccionados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Renaissance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
