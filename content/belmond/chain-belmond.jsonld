    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Belmond directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Belmond con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito de hotel, mejora de habitación, entrada anticipada y salida tardía y Wi-Fi de cortesía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sumo puntos de fidelización al reservar Belmond con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No está confirmado de forma pública que las reservas de asesor sumen puntos. Pregúntelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Belmond se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "33 hoteles en 16 países y territorios. Los países con más hoteles son Italia, Perú, Botsuana."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Belmond hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Belmond Casa de Sierra Nevada, Maroma, A Belmond Hotel. En España: Belmond La Residencia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Belmond hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1 hoteles: El Encanto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Belmond Bellini Club?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Belmond para asesores de viajes, por invitación, y abarca hoteles, lodges de safari, trenes y cruceros fluviales. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas dependen del hotel y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Belmond?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
