    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar EDITION directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar EDITION con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, mejora de habitación a la llegada, entrada anticipada y salida tardía con prioridad según disponibilidad, y un regalo de bienvenida VIP. El desayuno, el crédito y el regalo se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Marriott Bonvoy al reservar EDITION con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Las reservas hechas con Solo5Estrellas siguen acumulando puntos y noches de nivel de Marriott Bonvoy; su número de socio se añade a la reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles EDITION se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "22 hoteles en 12 países y territorios. Los países con más hoteles son Estados Unidos, China, Italia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles EDITION hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: The Riviera Maya EDITION at Kanai. En España: The Barcelona EDITION, The Madrid EDITION."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles EDITION hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 hoteles: The West Hollywood EDITION, The Miami Beach EDITION, The Tampa EDITION, The New York EDITION, The Times Square EDITION."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Marriott STARS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Marriott International para asesores de viaje de lujo; cubre EDITION, Ritz-Carlton, St. Regis, Bulgari, The Luxury Collection y Ritz-Carlton Reserve. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de EDITION?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
