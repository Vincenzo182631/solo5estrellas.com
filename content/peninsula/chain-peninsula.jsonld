    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar The Peninsula directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas de PenClub se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar The Peninsula con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de 100 USD para restauración o spa, mejora de categoría, entrada desde las 6:00, salida hasta las 22:00 y Wi-Fi de cortesía. Las condiciones se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿The Peninsula tiene programa de puntos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The Peninsula no tiene un programa de fidelización por puntos. Peninsula PenClub es el programa que ofrece ventajas a quienes reservan a través de asesores de viaje seleccionados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles The Peninsula se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12 hoteles en 8 países: tres en Estados Unidos, tres en China y uno en cada uno de los demás países."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde están los hoteles The Peninsula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En Hong Kong, Shanghái, Pekín, Tokio, Manila, Bangkok, París, Londres, Estambul, Nueva York, Chicago y Beverly Hills."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es el hotel The Peninsula más antiguo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Peninsula Hong Kong, el hotel original del grupo, que abrió en 1928."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Peninsula PenClub?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de The Peninsula Hotels para asesores de viaje seleccionados. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo entrar a las 6:00 o salir a las 22:00?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las ventajas incluyen entrada desde las 6:00 y salida hasta las 22:00, sujetas a fechas restringidas. Indique su hora de llegada al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de The Peninsula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; las tarifas corporativas pueden no ser elegibles."
          }
        }
      ]
    }
