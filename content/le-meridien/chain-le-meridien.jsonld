    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Le Méridien directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Le Méridien con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel (el importe varía según el hotel), mejora de categoría, entrada anticipada y salida tardía según disponibilidad, y un detalle de bienvenida. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Marriott Bonvoy al reservar Le Méridien con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página del hotel, sí: se añade su número de Marriott Bonvoy a la reserva y los puntos se suman en esa estancia. Confirme al reservar que esa tarifa suma puntos y noches de nivel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Le Méridien se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "25 hoteles en 14 países y territorios. Los países con más hoteles son Estados Unidos, Alemania, Austria."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Le Méridien hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México. En España: Le Meridien Barcelona."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Le Méridien hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "8 hoteles, entre ellos Le Méridien Pasadena Arcadia, Le Méridien Dania Beach at Fort Lauderdale Airport, Le Méridien Tampa, The Courthouse, Le Meridien Chicago - Oakbrook Center, Le Meridien New Orleans, Le Meridien St. Louis Clayton y 2 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Marriott Luminous?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Marriott International para asesores de viajes de las marcas premium, como Le Méridien, Westin, Renaissance, Sheraton, JW Marriott, W Hotels y Autograph Collection. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos; solo participan hoteles seleccionados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Le Méridien?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
