    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Fairmont directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Fairmont con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD para restauración o spa, mejora de categoría, y entrada anticipada y salida tardía sujetas a disponibilidad. El desayuno y el crédito se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Accor ALL al reservar Fairmont con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de cada hotel, sí: se añade su número de Accor ALL a la reserva y los puntos y noches de nivel se suman en esa estancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Fairmont se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "79 hoteles en 29 países y territorios. Estados Unidos tiene 20, Canadá 19 y China 5."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Fairmont hay en México?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dos, en Mayakoba, en la Riviera Maya: Fairmont Mayakoba y Fairmont Heritage Place Mayakoba. Ambos se pueden reservar con las ventajas de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Fairmont hay en España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uno: Fairmont La Hacienda Costa Del Sol, en Málaga. Se puede reservar con las ventajas de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de los hoteles no exige estancia mínima, aunque algunos resorts pueden pedir dos noches en temporada alta."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Fairmont?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué Fairmont elegir si busco un hotel histórico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre los más conocidos están Fairmont Banff Springs, Fairmont Empress, Fairmont Royal York, The Savoy, en Londres, y Fairmont Peace Hotel, en Shanghái."
          }
        }
      ]
    }
  ]
}