    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en El Caribe en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "123 hoteles en 22 países y territorios. Los países con más hoteles son República Dominicana, Islas Turcas y Caicos, Puerto Rico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué países de El Caribe tienen más hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "República Dominicana (20), Islas Turcas y Caicos (15), Puerto Rico (10). La tabla de esta página muestra el recuento de cada país y sus ciudades con más hoteles."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué marcas tienen más hoteles en El Caribe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Signature Collection (31), Small Luxury Hotels of The World (12), Leading Hotels of the World (10), Ritz Carlton Hotels & Resorts (7), St. Regis Hotels & Resorts (5). Cada marca tiene su propia página con las ventajas de reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más barato reservar con Solo5Estrellas que en la web del hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas de cada programa se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la marca y del hotel: en general desayuno diario para dos y un crédito de hotel, además de ventajas sujetas a disponibilidad como mejora de habitación, entrada anticipada o salida tardía. Las ventajas exactas se confirman al reservar y se detallan en la página de cada marca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está la lista completa de hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debajo, agrupada por país y ciudad. Los nombres de los hoteles no se traducen."
          }
        }
      ]
