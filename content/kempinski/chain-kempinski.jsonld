    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Kempinski directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Kempinski con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel cuyo importe depende del hotel, mejora de habitación, entrada anticipada y salida tardía según disponibilidad y, en algunos hoteles, un detalle de bienvenida. Las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sumo puntos de fidelización al reservar Kempinski con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No está confirmado de forma pública que las reservas de asesor sumen puntos. Pregúntelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Kempinski se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "18 hoteles en 14 países y territorios. Los países con más hoteles son Alemania, Jordania, Turquía."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Kempinski hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Kempinski Grand Hotel Cancun. En España: Kempinski Hotel Bahia Estepona."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Kempinski hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en Estados Unidos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Kempinski Club 1897?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Kempinski para asesores de viajes, por invitación. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas dependen del hotel y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Kempinski?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
