    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Centroamérica en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "35 hoteles en 6 países y territorios. Los países con más hoteles son Costa Rica, Panamá, Belice."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué países de Centroamérica tienen más hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costa Rica (18), Panamá (8), Belice (5). La tabla de esta página muestra el recuento de cada país y sus ciudades con más hoteles."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué marcas tienen más hoteles en Centroamérica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Signature Collection (8), Small Luxury Hotels of The World (4), Autograph Collection (2), JW Marriott Hotel (2), Marriott Hotels & Resorts (2). Cada marca tiene su propia página con las ventajas de reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más barato reservar con Solo5Estrellas que en la web del hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas de cada programa se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la marca y del hotel: en general desayuno diario para dos y un crédito de hotel, además de ventajas sujetas a disponibilidad como mejora de habitación, entrada anticipada o salida tardía. Las ventajas exactas se confirman al reservar y se detallan en la página de cada marca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está la lista completa de hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debajo, agrupada por país y ciudad. Los nombres de los hoteles no se traducen."
          }
        }
      ]
