      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Asia y el Pacífico en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "626 hoteles en 34 países y territorios. Los países con más hoteles son China, Tailandia, Japón."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué países de Asia y el Pacífico tienen más hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "China (179), Tailandia (77), Japón (76). La tabla de esta página muestra el recuento de cada país y sus ciudades con más hoteles."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué marcas tienen más hoteles en Asia y el Pacífico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small Luxury Hotels of The World (37), Four Seasons (34), InterContinental Hotels & Resorts (33), The Signature Collection (33), Shangri-la Hotels (29). Cada marca tiene su propia página con las ventajas de reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más barato reservar con Solo5Estrellas que en la web del hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas de cada programa se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la marca y del hotel: en general desayuno diario para dos y un crédito de hotel, además de ventajas sujetas a disponibilidad como mejora de habitación, entrada anticipada o salida tardía. Las ventajas exactas se confirman al reservar y se detallan en la página de cada marca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está la lista completa de hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debajo, agrupada por país y ciudad. Los nombres de los hoteles no se traducen."
          }
        }
      ]
