    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué destino elegir para una luna de miel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del viaje. Para villas sobre el agua, Maldivas o Bora Bora; para piscinas frente a la caldera, Santorini, de primavera a otoño; para un viaje corto desde México o Estados Unidos con hoteles solo para adultos, la Riviera Maya o Los Cabos; para combinar cultura y villas con piscina, Bali."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es un hotel solo para adultos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un hotel que no admite niños por debajo de una edad que fija cada hotel: en esta guía va de 13 a 18 años. Otros hoteles admiten niños pero tienen zonas solo para adultos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo viajar a Maldivas de luna de miel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre noviembre y abril, con el monzón del noreste, suele haber más sol. De mayo a octubre hay más lluvia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se llega a un hotel en Maldivas o Bora Bora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En Maldivas, en lancha rápida o hidroavión desde el aeropuerto de Malé. En Bora Bora, con un vuelo de unos 50 minutos desde Papeete y un barco desde el aeropuerto hasta el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay sargazo o huracanes en la Riviera Maya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La temporada de huracanes va del 1 de junio al 30 de noviembre, y el sargazo suele ser más intenso entre mayo y julio. Diciembre a abril es la época más seca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles ofrecen paquetes de luna de miel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre otros, Jade Mountain (\"Total Romance\"), Paradise Cove, Alila Villas Uluwatu (\"Clifftop Infinite Romance\"), Hotel Xcaret Arte (\"All the Art for Two\") y Conrad Maldives (\"Romantic Escapes\"). Las condiciones cambian, así que conviene confirmarlas al reservar."
          }
        }
      ]
    }
