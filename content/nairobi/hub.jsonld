    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Se necesita visado para Kenia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se necesita una Autorización Electrónica de Viaje (eTA), que se solicita antes del viaje en etakenya.go.ke."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué zona de Nairobi conviene antes de un safari?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Karen, cerca del aeropuerto Wilson, de donde salen las avionetas al Masái Mara."
          }
        },
        {
          "@type": "Question",
          "name": "¿A qué distancia está el aeropuerto del centro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El aeropuerto Jomo Kenyatta está a unos 18 km al sureste del centro."
          }
        },
        {
          "@type": "Question",
          "name": "¿Karen Blixen Camp está en Nairobi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No; está en el Masái Mara, en la reserva de Mara North, y se llega en avioneta desde el aeropuerto Wilson."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la mejor época para viajar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De junio a octubre, la temporada seca y la mejor para el safari."
          }
        }
      ]
    }
