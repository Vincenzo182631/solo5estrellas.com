    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar One&Only directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar One&Only con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD por estancia, mejora de habitación con prioridad, entrada anticipada y salida tardía según disponibilidad y reconocimiento VIP. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿One&Only tiene programa de puntos para estas reservas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nuestra página indica que no; no hemos encontrado una confirmación pública. Pregúntelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles One&Only se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "14 hoteles en 9 países y territorios. Los países con más hoteles son Emiratos Árabes Unidos, Grecia, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles One&Only hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: One&Only Mandarina, One&Only Palmilla. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles One&Only hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1 hoteles: One&Only Moonlight Basin, Montana."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Programa de socios preferentes de One&Only?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One&Only trabaja con un número reducido de agencias socias preferentes. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas dependen del hotel y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de One&Only?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
