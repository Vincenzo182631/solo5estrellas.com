    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Thompson Hotels directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Thompson Hotels con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito de hotel (100 USD), mejora de habitación (prioritaria, sujeta a disponibilidad), detalle de bienvenida y Wi-Fi de cortesía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de World of Hyatt al reservar Thompson Hotels con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Según la página de la marca, las reservas hechas a través de Hyatt Privé siguen sumando puntos y noches de nivel de World of Hyatt. Añada su número de socio a la reserva y confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Thompson Hotels se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "16 hoteles en 5 países y territorios. Los países con más hoteles son Estados Unidos, China, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Thompson Hotels hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: The Cape. En España: Thompson Madrid."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Thompson Hotels hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12 hoteles, entre ellos Thompson Denver, Thompson Washington D.C., Thompson Miami Beach, Thompson Savannah, Thompson Chicago, Gild Hall y 6 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Hyatt Privé?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Hyatt Hotels Corporation para asesores de viajes de lujo. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; en algunas marcas solo participan hoteles seleccionados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Thompson Hotels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
