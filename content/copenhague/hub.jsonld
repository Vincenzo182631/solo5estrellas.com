        {
          "@type": "Question",
          "name": "¿Cómo se llega del aeropuerto al centro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En metro, en unos 13 minutos hasta Kongens Nytorv, o en tren, en unos 15 minutos hasta la estación Central."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hotel está dentro de Tivoli?",
