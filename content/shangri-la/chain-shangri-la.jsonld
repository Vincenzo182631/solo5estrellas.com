    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Shangri-La directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Shangri-La con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel cuyo importe depende del hotel, mejora de habitación, entrada anticipada y salida tardía según disponibilidad, un detalle de bienvenida y Wi-Fi de cortesía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Shangri-La Circle al reservar Shangri-La con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según fuentes públicas, la reserva suma puntos de Shangri-La Circle. Añada su número de socio a la reserva y confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Shangri-La se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "40 hoteles en 21 países y territorios. Los países con más hoteles son China, Malasia, Filipinas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Shangri-La hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México ni en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Shangri-La hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en Estados Unidos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Shangri-La Luxury Circle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Shangri-La Group para asesores de viajes, por invitación. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel. No todos los hoteles del grupo participan; por ejemplo, Traders Hotels y JEN Hotels quedan fuera."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Shangri-La?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
  ]
