      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué se llama \"de la Reine\"?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Por Ana de Austria, que vivió en esta ala en el siglo XVII."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la place des Vosges, la plaza más antigua de París, en el Marais."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede comer en el patio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, el restaurante Anne pone su terraza en el patio cuando hace buen tiempo."
