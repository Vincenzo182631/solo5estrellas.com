      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Está abierto durante la reconstrucción?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Los dos edificios están abiertos; la Tower seguirá abierta hasta que empiece su demolición, prevista hacia finales del año fiscal 2030."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es la Frank Lloyd Wright Suite?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una suite de 214 m² en el Main Building, en homenaje al arquitecto del edificio de 1923."
          }
        },
