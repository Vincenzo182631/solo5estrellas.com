    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Sofitel directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Sofitel con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, un detalle de bienvenida y Wi-Fi de cortesía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Accor ALL al reservar Sofitel con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de cada hotel, sí: se añade su número de Accor ALL a la reserva y los puntos y noches de nivel se suman en esa estancia. Confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Sofitel se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "71 hoteles en 33 países y territorios. Los países con más hoteles son Australia, Francia, Estados Unidos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Sofitel hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Sofitel Mexico City Reforma. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Sofitel hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 hoteles: Sofitel Los Angeles at Beverly Hills, Sofitel Washington DC Lafayette Square, Sofitel Chicago Magnificent Mile, Sofitel New York, Sofitel Philadelphia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el programa de Accor para asesores de viaje?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Accor para asesores de viaje de lujo y abarca marcas como Raffles, Fairmont, Sofitel, Banyan Tree, SLS y MGallery. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Sofitel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
  ]
}