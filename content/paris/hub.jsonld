    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el mejor hotel de lujo en París?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del barrio. En el Triángulo de Oro, el Four Seasons Hotel George V, Le Bristol o el Hôtel Plaza Athénée; junto a las Tullerías y la plaza Vendôme, Le Meurice, el Ritz Paris o el Hôtel de Crillon; en la orilla izquierda, el Mandarin Oriental Lutetia."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué barrio de París conviene alojarse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para un primer viaje, en el Triángulo de Oro o cerca de las Tullerías y el Louvre: tiendas, museos y buen acceso en metro. Si prefiere cafés y calma, Saint-Germain; si quiere ver la Torre Eiffel, el Trocadéro."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde alojarse en París para unas vacaciones de lujo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En uno de los barrios de esta página. Su asesor puede ayudarle a elegir según las fechas, el presupuesto y si viaja en pareja o en familia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles de lujo hay cerca de la Torre Eiffel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Peninsula Paris, Shangri-La Hotel Paris, Sofitel Paris Baltimore Tour Eiffel y Renaissance Paris Nobel Tour Eiffel Hotel, entre otros de la zona de Torre Eiffel y Trocadéro."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es mejor viajar a París?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De abril a junio y de septiembre a octubre, por el clima, aunque son meses de más demanda. En julio y agosto hace calor y algunos restaurantes locales cierran; en diciembre hay luces de Navidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto se tarda del aeropuerto al hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desde Charles de Gaulle, el RER B tarda unos 30 a 50 minutos y el taxi depende del tráfico. Desde Orly, la línea 14 del metro llega a Châtelet-Les Halles en unos 25 a 30 minutos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según el hotel, desayuno diario para dos, crédito de hotel y mejora de categoría sujeta a disponibilidad. Las condiciones se muestran en la ficha de cada hotel y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede reservar un Four Seasons en París?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: Four Seasons Paris, George V, en el Triángulo de Oro. Se reserva a la tarifa publicada, con las ventajas del programa Four Seasons Preferred Partner."
          }
        }
      ]
    }
