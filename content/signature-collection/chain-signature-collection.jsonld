    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Signature Collection directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Signature Collection con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito de hotel, mejora de habitación y entrada anticipada y salida tardía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sumo puntos de fidelización al reservar Signature Collection con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No está confirmado de forma pública que las reservas de asesor sumen puntos. Pregúntelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Signature Collection se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "435 hoteles en 66 países y territorios. Los países con más hoteles son Estados Unidos, Italia, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Signature Collection hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Alexander Hotel, Atelier Playa Mujeres, Conrad Tulum Riviera Maya, Habitas Bacalar, Habitas Tulum, Hilton Cancun, An All Inclusive Resort y 14 más. En España: Alhambra Palace Hotel, Convent de la Missio, Gran Melia Palacio de Isora, Hotel Villa Real, Nobu Hotel Ibiza Bay, Nobu Hotel Marbella y 3 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Signature Collection hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "168 hoteles, entre ellos Canyon Ranch, Tucson All Inclusive, Enchantment Resort, Hotel Valley Ho, Mii Amo, Miraval Arizona Resort & Spa, Omni Tempe Hotel at ASU y 162 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Signature Travel Network (Signature Collection)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es la colección de hoteles de Signature Travel Network, un consorcio de agencias de viajes. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas dependen del hotel y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Signature Collection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
