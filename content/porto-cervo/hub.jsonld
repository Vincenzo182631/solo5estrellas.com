      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el aeropuerto más cercano a Porto Cervo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Olbia Costa Smeralda (OLB), a unos 30 km, entre 35 y 45 minutos por carretera."
          }
        },
        {
          "@type": "Question",
          "name": "¿Los hoteles de la Costa Esmeralda abren todo el año?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Abren aproximadamente de abril o mayo a octubre; confirme las fechas con su asesor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede llegar en ferri desde España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: Grimaldi Lines une Barcelona con Porto Torres, en unas 12 a 15 horas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hotel está en el pueblo de Porto Cervo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cervo Hotel, frente a la Piazzetta y el puerto deportivo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hotel tiene villas con piscina privada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Romazzino, A Belmond Hotel, con seis villas con piscina."
          }
        }
      ]
