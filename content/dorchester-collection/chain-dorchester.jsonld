    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Dorchester Collection directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Dorchester Collection con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, entrada anticipada y salida tardía según disponibilidad, y una bienvenida de la dirección del hotel. El desayuno, el crédito y la bienvenida se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dorchester Collection tiene programa de puntos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Dorchester Collection no tiene un programa de fidelización por puntos; las ventajas de Diamond Club son el reconocimiento que recibe en cada estancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles de Dorchester Collection se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Dorchester y 45 Park Lane, en Londres; Le Meurice y el Hôtel Plaza Athénée, en París; Hotel Eden, en Roma; Hotel Principe di Savoia, en Milán; The Beverly Hills Hotel y Hotel Bel-Air, en Los Ángeles, y The Lana, en Dubái."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles de Dorchester Collection hay en París?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le Meurice y el Hôtel Plaza Athénée. Los dos se pueden reservar con las ventajas de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles de Dorchester Collection hay en Londres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Dorchester y 45 Park Lane, los dos en Mayfair."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Dorchester Collection Diamond Club?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Dorchester Collection para asesores de viaje seleccionados. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué tarifas no son elegibles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según las condiciones habituales del programa, no aplican las tarifas prepagadas, las reservas en agencias en línea, las estancias con puntos ni las tarifas corporativas. El motor de reservas indica qué tarifas incluyen las ventajas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Dorchester Collection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta."
          }
        }
      ]
    }
