    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Europa en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "981 hoteles en 39 países y territorios. Los países con más hoteles son Italia, Reino Unido, Francia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué países de Europa tienen más hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Italia (215), Reino Unido (129), Francia (112). La tabla de esta página muestra el recuento de cada país y sus ciudades con más hoteles."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué marcas tienen más hoteles en Europa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small Luxury Hotels of The World (198), The Signature Collection (111), Leading Hotels of the World (88), Preferred Hotels & Resorts (74), Autograph Collection (56). Cada marca tiene su propia página con las ventajas de reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más barato reservar con Solo5Estrellas que en la web del hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas de cada programa se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la marca y del hotel: en general desayuno diario para dos y un crédito de hotel, además de ventajas sujetas a disponibilidad como mejora de habitación, entrada anticipada o salida tardía. Las ventajas exactas se confirman al reservar y se detallan en la página de cada marca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está la lista completa de hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debajo, agrupada por país y ciudad. Los nombres de los hoteles no se traducen."
          }
        }
      ]
    }
  ]
