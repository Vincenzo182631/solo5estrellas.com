      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Se puede llegar en coche a Portofino?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, hasta el aparcamiento de la piazza della Libertà; el centro es peatonal."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la estación de tren más cercana?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Santa Margherita Ligure, unida a Portofino por el autobús 82 y, en temporada, por barco."
          }
        },
        {
          "@type": "Question",
          "name": "¿Los hoteles abren todo el año?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Abren aproximadamente de marzo o mayo a noviembre; Splendido Mare abre también en Navidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es el aeropuerto más cercano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Génova, a alrededor de una hora en coche."
          }
        }
      ]
