    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Westin directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Westin con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de hasta 200 USD, mejora de habitación según disponibilidad en el check-in, entrada anticipada y salida tardía con prioridad según disponibilidad, y un regalo de bienvenida VIP. Las condiciones se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Marriott Bonvoy al reservar Westin con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de cada hotel, sí: se añade su número de Marriott Bonvoy a la reserva. Confirme al reservar que esa tarifa suma puntos y noches de nivel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Westin se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "52 hoteles en 23 países y territorios. Los países con más hoteles son Estados Unidos, Indonesia, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Westin hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: The Westin Playa Vallarta, an All-Inclusive Resort Accepting Bookings starting May 2026 , Westin Santa Fe Mexico City. En España: The Westin La Quinta Golf Resort & Spa, The Westin Valencia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Westin hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "26 hoteles, entre ellos The Westin Kierland Resort & Spa, The Westin Phoenix Downtown, The Westin Tempe, The Westin Anaheim Resort, The Westin Carlsbad Resort & Spa, The Westin Mission Hills Resort & Spa y 20 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Marriott Luminous?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Marriott International para asesores de viaje de las marcas premium, como Westin, Renaissance, Sheraton, JW Marriott, W Hotels, Le Méridien y Autograph Collection. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos; solo participan hoteles seleccionados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Westin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
