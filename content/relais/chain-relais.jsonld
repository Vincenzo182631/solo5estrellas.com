    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Relais & Châteaux directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Relais & Châteaux con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de hasta 100 USD, mejora de categoría, entrada anticipada y salida tardía según disponibilidad, un detalle de bienvenida y Wi-Fi de cortesía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Relais & Châteaux tiene programa de fidelización?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No hay un programa de puntos de Relais & Châteaux, así que las ventajas son el reconocimiento que recibe en cada estancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Relais & Châteaux se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "25 hoteles en 14 países y territorios. Los países con más hoteles son Italia, Estados Unidos, Portugal."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Relais & Châteaux hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México. En España: Hotel Neri Barcelona."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Relais & Châteaux hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4 hoteles: Meadowood Napa Valley, Blackberry Farm, Blackberry Mountain, The Inn at Little Washington."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el programa de socios preferentes de Relais & Châteaux?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el acuerdo de Relais & Châteaux con asesores de viaje seleccionados. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas pueden variar según el establecimiento."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Relais & Châteaux?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
