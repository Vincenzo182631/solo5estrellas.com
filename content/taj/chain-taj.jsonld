    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Taj directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Taj con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, entrada anticipada y salida tardía según disponibilidad, y un detalle de bienvenida. El desayuno, el crédito y el detalle se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Taj InnerCircle al reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se confirma al hacer la reserva, así que facilite su número de socio. Según las condiciones de Taj InnerCircle, los puntos se acumulan en reservas hechas por los canales de Taj; pregunte antes de reservar si esta reserva los suma."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Taj se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En India: The Taj Mahal Palace, en Bombay; Taj Mahal, en Nueva Delhi; Rambagh Palace, en Jaipur; Taj Lake Palace, en Udaipur, y Umaid Bhawan Palace, en Jodhpur. Fuera de India: The Pierre, en Nueva York; Taj Campton Place, en San Francisco; Taj 51 Buckingham Gate, en Londres; Taj Dubai y Taj Exotica The Palm, en Dubái; Taj Exotica Maldives y Taj Cape Town."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es el hotel Taj más antiguo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El Taj Mahal Palace de Bombay, con el que nació la marca en 1903. Se puede reservar con las ventajas de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Taj hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Pierre, en Nueva York, y Taj Campton Place, en San Francisco."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué Taj elegir para ver los palacios de India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rambagh Palace, en Jaipur; Taj Lake Palace, en Udaipur; Umaid Bhawan Palace, en Jodhpur, y The Taj Mahal Palace, en Bombay."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima o fechas excluidas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Taj?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
