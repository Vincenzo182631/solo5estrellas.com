    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué zona de Mallorca es mejor para alojarse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del viaje: Palma para una escapada urbana; la Serra de Tramuntana para montaña y pueblos; el suroeste para playa cerca del aeropuerto; el norte y el este para calas y naturaleza."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay hoteles de lujo solo para adultos en Mallorca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En esta página: Convent de la Missió (desde 16 años), Castillo Hotel Son Vida, Pleta de Mar, Fontsanta y Finca Serena."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo abren los hoteles de lujo de Mallorca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muchos hoteles de playa y de montaña abren de marzo a octubre o noviembre; en 2026, por ejemplo, Belmond La Residencia abrió el 12 de marzo y Four Seasons Formentor el 18 de marzo. Los hoteles de Palma suelen abrir todo el año."
          }
        },
        {
          "@type": "Question",
          "name": "¿A qué distancia está el aeropuerto de Palma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A unos 8 km del centro de Palma. Hasta el suroeste se tarda unos 20 minutos; hasta Deià, unos 45, y hasta Formentor, alrededor de una hora."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es la Serra de Tramuntana?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cordillera de la costa noroeste de Mallorca, Paisaje Cultural Patrimonio Mundial de la UNESCO desde 2011."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay que pagar impuesto turístico en Mallorca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El Impuesto de Turismo Sostenible se paga en el alojamiento, por persona y noche."
          }
        }
      ]
    }
