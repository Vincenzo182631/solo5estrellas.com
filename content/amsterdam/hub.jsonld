    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿En qué barrio alojarse en Ámsterdam?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el Anillo de Canales, Patrimonio Mundial de la UNESCO, para alojarse en casas históricas; en Museumplein, junto a los grandes museos; junto al Amstel, para vistas al río; o en Centrum, cerca de la estación Centraal."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se va del aeropuerto al centro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En tren de Schiphol a Ámsterdam Centraal, en unos 17 minutos, o en el autobús 397 hacia Museumplein y Leidseplein."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es la temporada de tulipanes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De mediados de marzo a mediados de mayo. Keukenhof abre del 18 de marzo al 9 de mayo de 2027."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el Día del Rey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La fiesta nacional del 27 de abril, con mercadillos en la calle y la ciudad vestida de naranja."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay tasa turística en Ámsterdam?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, un porcentaje del precio de la habitación, de los más altos de Europa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles de lujo ocupan edificios históricos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rosewood (antiguo Palacio de Justicia), Sofitel Legend The Grand (antiguo ayuntamiento), Andaz (antigua biblioteca pública), Mandarin Oriental Conservatorium (antiguo banco y conservatorio) y Waldorf Astoria (seis palacios del Herengracht), entre otros."
          }
        }
      ]
    }
