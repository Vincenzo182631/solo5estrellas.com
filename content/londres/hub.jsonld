    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el mejor hotel de lujo en Londres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la zona. En Mayfair, Claridge's, The Connaught o The Dorchester; en St James's, The Ritz London; en Knightsbridge, The Berkeley o The Lanesborough; junto al Támesis, The Savoy o Shangri-La Hotel at The Shard."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué zona de Londres conviene alojarse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para un primer viaje, en Mayfair o Knightsbridge: tiendas, parques y buen acceso en metro. Si prefiere teatros y restaurantes, el West End; si va a ver los monumentos, Westminster."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde alojarse en Londres para unas vacaciones de lujo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En una de las zonas de esta página. Su asesor puede ayudarle a elegir según las fechas, el presupuesto y si viaja en pareja o en familia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles de Londres hay en Mayfair?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre otros, Claridge's, The Connaught, The Dorchester, Brown's Hotel London, Four Seasons London at Park Lane y The Chesterfield Mayfair Hotel. La lista completa está en la zona de Mayfair y Park Lane."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es mejor viajar a Londres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De abril a septiembre, por el clima y los días largos, aunque son meses de más demanda. Octubre y noviembre tienen menos visitantes; en diciembre hay luces y mercados navideños."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto se tarda del aeropuerto al hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desde Heathrow, el Heathrow Express tarda unos 15 minutos a Paddington y la línea Elizabeth unos 30 a 40 minutos a Bond Street; desde Gatwick, el tren a Victoria tarda unos 30 minutos. Los tiempos en coche dependen del tráfico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según el hotel, desayuno diario para dos, crédito de hotel y mejora de categoría sujeta a disponibilidad. Las condiciones se muestran en la ficha de cada hotel y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede reservar un Four Seasons en Londres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: Four Seasons London at Park Lane, en Mayfair, y Four Seasons London at Tower Bridge, junto al Támesis. Se reservan a la tarifa publicada, con las ventajas del programa Four Seasons Preferred Partner."
          }
        }
      ]
    }
  ]
}