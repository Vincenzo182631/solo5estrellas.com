        {
          "@type": "Question",
          "name": "¿Barracuda está en Salvador de Bahía?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No; está en Itacaré, en la costa sur de Bahía. El aeropuerto más cercano es el de Ilhéus."
