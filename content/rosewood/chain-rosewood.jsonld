    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Rosewood directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Rosewood con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, entrada anticipada y salida tardía según disponibilidad, un detalle de bienvenida y Wi-Fi de cortesía. Las condiciones dependen del hotel y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Rosewood tiene programa de puntos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Rosewood no tiene un programa de fidelización por puntos; las ventajas de Rosewood Elite son el reconocimiento que recibe en cada estancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Rosewood se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "42 hoteles en 23 países y territorios. Los países con más hoteles son Estados Unidos, China, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Rosewood hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Las Ventanas Al Paraiso, Rosewood Mandarina, Rosewood Mayakoba, Rosewood San Miguel Allende. En España: Rosewood Villa Magna."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Rosewood hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "7 hoteles: Rosewood Miramar Beach Hotel, Rosewood Sand Hill, Rosewood Washington, D.C., Kona Village, A Rosewood Resort, Rosewood Inn of the Anasazi, The Carlyle, A Rosewood Hotel, Rosewood Mansion On Turtle Creek."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Rosewood Elite?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Rosewood Hotel Group para asesores de viaje seleccionados. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y la prioridad para la mejora de habitación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Rosewood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
