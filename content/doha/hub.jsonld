    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo se llega del aeropuerto al hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la línea roja del metro, que une la Terminal 1 del aeropuerto de Hamad con el centro, West Bay y Lusail, o en taxi."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la mejor época para viajar a Doha?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De noviembre a febrero, con temperaturas de 15 a 20 °C."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles tienen playa privada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre otros, The Ritz-Carlton, The St. Regis, Grand Hyatt, InterContinental Doha Beach & Spa, Sharq Village, Waldorf Astoria Lusail y Four Seasons at The Pearl."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hotel está más cerca del Souq Waqif?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los de Msheireb Downtown: Mandarin Oriental, Park Hyatt y Banyan Tree."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito visado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los ciudadanos españoles pueden entrar sin visado previo para estancias turísticas; confirme las condiciones en visitqatar.com."
          }
        }
      ]
