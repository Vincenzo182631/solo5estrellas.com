    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Montage directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Montage con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, prioridad para la mejora de habitación, entrada anticipada y salida tardía según disponibilidad, reconocimiento VIP y Wi-Fi de cortesía. Las condiciones se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Montage tiene programa de puntos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Montage no tiene un programa de fidelización por puntos; las ventajas de socio preferente son el reconocimiento que recibe en cada estancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Montage se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "6 hoteles en 2 países y territorios. Los países con más hoteles son Estados Unidos, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Montage hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Montage Los Cabos, Mexico. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Montage hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 hoteles: Montage Healdsburg, Montage Laguna Beach, Montage Big Sky, Montage Palmetto Bluff, Montage Deer Valley."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el programa de socio preferente de Montage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Montage trabaja con un número reducido de agencias de viaje socias preferentes, y Solo5Estrellas es una de ellas. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Montage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
