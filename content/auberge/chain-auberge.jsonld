    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Auberge Resorts Collection directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Auberge Resorts Collection con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito de hotel (100 USD por estancia), mejora de habitación y entrada anticipada y salida tardía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Auberge Resorts Collection tiene programa de puntos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según fuentes públicas, no tiene un programa de fidelización tradicional. Confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Auberge Resorts Collection se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "26 hoteles en 8 países y territorios. Los países con más hoteles son Estados Unidos, México, Anguila."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Auberge Resorts Collection hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Chileno Bay Resort, Auberge Collection, Esperanza, Auberge Collection, Etereo Kanai , Auberge Collection, Susurros del Corazón, Auberge Collection. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Auberge Resorts Collection hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "16 hoteles, entre ellos Solage, Auberge Collection, Stanly Ranch, Auberge Collection, The Inn at Mattei's Tavern, Auberge Collection, Element 52, Auberge Collection, Hotel Jerome, Auberge Collection, Madeline Hotel & Residences, Auberge Collection y 10 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Programa de socios preferentes de Auberge Resorts Collection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Auberge trabaja con agencias de viajes socias preferentes seleccionadas. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel; las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Auberge Resorts Collection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
