      "publisher": {
        "@type": "TravelAgency",
        "name": "Lorraine Travel",
        "url": "https://solo5estrellas.com/"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre Dorchester Collection y Rosewood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dorchester Collection es un grupo pequeño de 10 hoteles clásicos en grandes ciudades de Europa, Los Ángeles y Dubái. Rosewood es más grande, con unas 44 propiedades en todo el mundo, entre ellas resorts de playa en México y el Caribe."
          }
        },
        {
          "@type": "Question",
          "name": "¿Rosewood o Dorchester Collection tienen programa de puntos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ninguno de los dos. Sus programas para agencias de viaje son Rosewood Elite y Dorchester Collection Diamond Club, con ventajas como desayuno para dos y mejora de categoría según disponibilidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Rosewood hay en México?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las Ventanas al Paraíso (Los Cabos), Rosewood Mayakoba (Riviera Maya), Rosewood San Miguel de Allende y Rosewood Mandarina (Riviera Nayarit). Rosewood Mexico City abrirá en 2027, según Rosewood."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay hoteles Dorchester Collection en España o Latinoamérica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No; no hay ninguno abierto ni anunciado. En España, Rosewood tiene Rosewood Villa Magna, en Madrid."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles de cada marca hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dorchester Collection tiene The Beverly Hills Hotel y Hotel Bel-Air, en Los Ángeles. Rosewood tiene siete, entre ellos The Carlyle, en Nueva York, y Rosewood Washington, D.C."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigue abierto el Hotel Principe di Savoia de Milán?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, hasta el 31 de diciembre de 2026. Cierra por restauración desde el 1 de enero de 2027 y prevé reabrir en 2029."
          }
        }
      ]
    }
  ]
