    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Tribute Portfolio directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Tribute Portfolio con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, crédito de hotel (100 USD por estancia), mejora de habitación, entrada anticipada y salida tardía y detalle de bienvenida. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Marriott Bonvoy al reservar Tribute Portfolio con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de la marca, sí: las reservas hechas a través de Marriott Luminous siguen sumando puntos y noches de nivel de Marriott Bonvoy. Añada su número de socio a la reserva y confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Tribute Portfolio se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "21 hoteles en 11 países y territorios. Los países con más hoteles son Estados Unidos, Francia, Singapur."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Tribute Portfolio hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México. En España: Labtwentytwo Barcelona, a Tribute Portfolio Hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Tribute Portfolio hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "8 hoteles, entre ellos Avenue of the Arts Costa Mesa, The Glenmark, Glendale, a Tribute Portfolio Hotel, The Guild Hotel, San Diego, a Tribute Portfolio Hotel, The Ven at Embassy Row, Washington, DC, Hotel Landy Orlando, a Tribute Portfolio Hotel, The Alida Savannah, a Tribute Portfolio Hotel y 2 más; la lista completa está en esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Marriott Luminous?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Marriott International para asesores de viaje y abarca JW Marriott, Marriott, W Hotels, Westin, Autograph Collection, Le Méridien, Sheraton, Renaissance y Tribute Portfolio. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Tribute Portfolio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
