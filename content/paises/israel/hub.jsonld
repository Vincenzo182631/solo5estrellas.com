        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Israel en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "14 hoteles. Las ciudades con más hoteles son Tel Aviv (7), Jerusalén (5), Herzliya (1)."
