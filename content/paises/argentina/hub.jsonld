        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Argentina en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "11 hoteles. Las ciudades con más hoteles son Buenos Aires (7), Bariloche (1), East Grinstead (1)."
