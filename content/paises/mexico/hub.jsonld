          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en México en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "110 hoteles. Las ciudades con más hoteles son Cabo San Lucas (22), Cancún (19), Ciudad de México (17)."
          }
