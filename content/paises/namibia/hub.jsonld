        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Namibia en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "2 hoteles. Las ciudades con más hoteles son Sin ciudad indicada (1), Kulala Wilderness Reserve (1)."
