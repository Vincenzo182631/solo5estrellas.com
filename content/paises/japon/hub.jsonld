    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Japón en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "77 hoteles. Las ciudades con más hoteles son Tokio (35), Kioto (14), Osaka (9)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué ciudades de Japón tienen más hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tokio (35), Kioto (14), Osaka (9). La tabla de esta página muestra el recuento de cada ciudad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué marcas tienen más hoteles en Japón?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ritz Carlton Hotels & Resorts (6), The Signature Collection (6), InterContinental Hotels & Resorts (5), Small Luxury Hotels of The World (5), The Luxury Collection (5). Cada marca tiene su propia página con las ventajas de reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más barato reservar con Solo5Estrellas que en la web del hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas de cada programa se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la marca y del hotel: en general desayuno diario para dos y un crédito de hotel, además de ventajas sujetas a disponibilidad como mejora de habitación, entrada anticipada o salida tardía. Las ventajas exactas se confirman al reservar y se detallan en la página de cada marca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está la lista completa de hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debajo, agrupada por ciudad. Los nombres de los hoteles no se traducen."
          }
        }
      ]
    }
  ]
