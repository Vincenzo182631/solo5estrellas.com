    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Grecia en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "80 hoteles. Las ciudades con más hoteles son Santorini (16), Mykonos (13), Atenas (12)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué ciudades de Grecia tienen más hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Santorini (16), Mykonos (13), Atenas (12). La tabla de esta página muestra el recuento de cada ciudad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué marcas tienen más hoteles en Grecia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small Luxury Hotels of The World (28), The Luxury Collection (10), Autograph Collection (8), Preferred Hotels & Resorts (4), The Signature Collection (3). Cada marca tiene su propia página con las ventajas de reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más barato reservar con Solo5Estrellas que en la web del hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas de cada programa se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la marca y del hotel: en general desayuno diario para dos y un crédito de hotel, además de ventajas sujetas a disponibilidad como mejora de habitación, entrada anticipada o salida tardía. Las ventajas exactas se confirman al reservar y se detallan en la página de cada marca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está la lista completa de hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debajo, agrupada por ciudad. Los nombres de los hoteles no se traducen."
          }
        }
      ]
    }
  ]
