    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Sheraton directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Sheraton con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD por estancia, mejora de habitación según disponibilidad, un detalle de bienvenida y Wi-Fi de cortesía. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Marriott Bonvoy al reservar Sheraton con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la página de la marca, sí: las reservas hechas a través de Marriott Luminous siguen sumando puntos y noches de nivel de Marriott Bonvoy. Añada su número de socio a la reserva y confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Sheraton se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "24 hoteles en 19 países y territorios. Los países con más hoteles son Estados Unidos, Italia, Vietnam."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Sheraton hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En México: Sheraton Mexico City Maria Isabel. Esta página no incluye hoteles en España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Sheraton hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4 hoteles: Sheraton Kauai Coconut Beach Resort, Sheraton Kauai Resort, Sheraton Maui Resort & Spa, Sheraton Waikiki."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Marriott Luminous?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Marriott International para asesores de viaje y abarca JW Marriott, Marriott, W Hotels, Westin, Autograph Collection, Le Méridien, Sheraton, Renaissance y Tribute Portfolio. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Sheraton?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
