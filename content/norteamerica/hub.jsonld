    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles de lujo hay en Norteamérica en Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "812 hoteles en 6 países y territorios. Los países con más hoteles son Estados Unidos, Canadá, México."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué países de Norteamérica tienen más hoteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estados Unidos (793), Canadá (8), México (8). La tabla de esta página muestra el recuento de cada país y sus ciudades con más hoteles."
          }
        },
        {
          "@type": "Question",
