    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es Mayakoba?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un complejo turístico privado de unas 240 hectáreas en Playa del Carmen, con lagunas, manglares, una milla de playa, hoteles de lujo y el campo de golf El Camaleón."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles hay en Mayakoba?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rosewood Mayakoba, Banyan Tree Mayakoba, Fairmont Mayakoba y Alila Mayakoba, además de las residencias Fairmont Heritage Place. Todos están en la colección Solo5Estrellas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Mayakoba es todo incluido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No como complejo. Fairmont Mayakoba y Fairmont Heritage Place ofrecen un plan todo incluido opcional; Rosewood y Banyan Tree se reservan sin él."
          }
        },
        {
          "@type": "Question",
          "name": "¿A qué distancia está Mayakoba del aeropuerto de Cancún?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A unos 48 km, unos 40 minutos en coche."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigue el torneo de golf del PGA Tour en Mayakoba?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El torneo se jugó en El Camaleón de 2007 a 2022 y desde 2023 se celebra en Los Cabos. En enero de 2027 El Camaleón recibe el Latin America Amateur Championship."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo hay sargazo en Mayakoba?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El sargazo suele llegar a las playas del Caribe mexicano entre abril y octubre, según la Secretaría de Marina; la cantidad varía cada año."
          }
        }
      ]
    }
  ]
