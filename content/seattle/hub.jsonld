      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo se llega del aeropuerto al centro de Seattle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el tren ligero Link, en unos 38 minutos, sin necesidad de coche."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la mejor época para visitar Seattle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De junio a septiembre, la época más seca y soleada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hotel está junto al mercado de Pike Place?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Four Seasons Hotel Seattle y Thompson Seattle están a pocos pasos del mercado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué fue del Pan Pacific Hotel Seattle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reabrió en abril de 2025 como 1 Hotel Seattle, en la misma dirección de South Lake Union."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se necesita visado para viajar a Seattle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los ciudadanos de países del Programa de Exención de Visados, como España, necesitan una autorización ESTA aprobada antes del viaje."
          }
        }
