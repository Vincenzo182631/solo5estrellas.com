          "@type": "Question",
          "name": "¿Cómo se llega?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En avión privado a Saratoga, o por carretera desde Laramie (una hora) o Denver (unas tres horas y media)."
