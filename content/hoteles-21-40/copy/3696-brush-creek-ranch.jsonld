        {
          "@type": "Question",
          "name": "¿Brush Creek Ranch es todo incluido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: comidas, una selección de bebidas y dos actividades al día; el spa se paga aparte."
