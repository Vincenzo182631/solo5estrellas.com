        {
          "@type": "Question",
          "name": "¿Cómo se llega a Calala Island?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Con un vuelo de 50 minutos de Managua a Bluefields y 90 minutos en barco, incluidos en la tarifa; el helicóptero es opcional."
