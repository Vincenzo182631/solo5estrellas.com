        {
          "@type": "Question",
          "name": "¿Qué incluye la tarifa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las comidas, bebidas premium, Wi-Fi y servicio en la suite las 24 horas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos yates tiene?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tres: Evrima (149 suites), Ilma (224) y Luminara (226)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay salidas desde Atenas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, algunas rutas salen del puerto del Pireo; por ejemplo, Ilma tiene un crucero de cuatro noches con salida y regreso en Atenas el 13 de mayo de 2027."
