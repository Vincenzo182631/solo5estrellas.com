      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo se llega a Sentosa desde Singapur?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el monorraíl Sentosa Express desde VivoCity, en teleférico, a pie por la Sentosa Boardwalk o en coche."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto se tarda desde el aeropuerto de Changi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unos 25 a 30 minutos en taxi, según el tráfico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hotel tiene villas con piscina privada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Raffles Sentosa Singapore, con 62 villas, todas con piscina privada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hotel conviene para familias?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Shangri-La Rasa Sentosa, frente a la playa de Siloso, con club infantil y toboganes."
          }
        },
