    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Mandarin Oriental directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Mandarin Oriental con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de 100 USD por estancia para restauración o spa, mejora de una categoría de habitación, entrada anticipada y salida tardía según disponibilidad, y reconocimiento VIP con detalle de bienvenida. Las ventajas se confirman al reservar y pueden variar según el hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo combinar Fans of M.O. con las ventajas de Mandarin Oriental Fan Club?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según fuentes públicas, no: hay que elegir entre Fans of M.O., el programa gratuito de reserva directa, y las ventajas de Fan Club. Confírmelo al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Mandarin Oriental se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "48 hoteles en 26 países y territorios. Los países con más hoteles son China, Malasia, España."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Mandarin Oriental hay en México y España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Esta página no incluye hoteles en México. En España: Mandarin Oriental Barcelona, Mandarin Oriental Punta Negra, Mallorca, Mandarin Oriental Ritz, Madrid."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Mandarin Oriental hay en Estados Unidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "2 hoteles: Mandarin Oriental Boston, Mandarin Oriental, New York."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Mandarin Oriental Fan Club?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Mandarin Oriental para asesores de viajes seleccionados. Las reservas se hacen a las tarifas publicadas del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito para restauración o spa; las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay estancia mínima para las ventajas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las condiciones exactas se muestran en la ficha de cada hotel y en el motor de reservas, y se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Mandarin Oriental?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
  ]
