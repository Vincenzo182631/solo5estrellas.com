        "streetAddress": "Calle de Sevilla, 3",
        "postalCode": "28014",
        "addressLocality": "Madrid",
        "addressCountry": "ES"
      },
      "numberOfRooms": 200,
      "starRating": {
        "@type": "Rating",
        "ratingValue": "5"
      },
      "containedInPlace": {
        "@type": "City",
        "name": "Madrid"
