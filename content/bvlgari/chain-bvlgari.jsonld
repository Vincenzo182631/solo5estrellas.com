    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es más barato reservar Bulgari directamente que con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Con Solo5Estrellas paga la misma tarifa publicada que el hotel, y las ventajas se añaden a esa tarifa sin cargo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye reservar Bulgari con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desayuno diario para dos, un crédito de hotel de 100 USD, mejora de habitación con prioridad sujeta a disponibilidad, detalle de bienvenida, reconocimiento VIP y Wi-Fi de cortesía. Excepto la mejora, las ventajas se confirman al reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sigo sumando puntos de Marriott Bonvoy al reservar Bulgari con Solo5Estrellas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Las reservas hechas con Solo5Estrellas siguen acumulando puntos y noches de nivel de Marriott Bonvoy; su número de socio se añade a la reserva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos hoteles Bulgari se pueden reservar en esta página?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "9 hoteles en 7 países: dos en Italia y dos en China, y uno en cada uno de los demás."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hoteles Bulgari hay en Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bvlgari Hotel Milano, en Milán, y Bvlgari Hotel Roma, en Roma. Los dos se pueden reservar con las ventajas de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál fue el primer hotel Bulgari?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El de Milán, que abrió en 2004. Se puede reservar con las ventajas de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Marriott STARS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el programa de Marriott International para asesores de viaje de lujo; cubre Bulgari, Ritz-Carlton, St. Regis, The Luxury Collection y EDITION. Las reservas se hacen a la tarifa publicada del hotel e incluyen ventajas de cortesía como el desayuno diario para dos y un crédito de hotel."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay Bulgari en Asia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: Bvlgari Hotel Tokyo, Bvlgari Hotel Beijing, Bvlgari Shanghai y Bvlgari Resort Bali."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pueden combinar las ventajas con las ofertas de Bulgari?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, si reserva la tarifa de la oferta a través de Solo5Estrellas. Se decide oferta por oferta; el motor de reservas indica qué tarifas incluyen las ventajas."
          }
        }
      ]
    }
